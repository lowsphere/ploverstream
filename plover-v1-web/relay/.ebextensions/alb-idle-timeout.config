# Raise the load balancer idle timeout so a quiet-but-open pixel stream is not
# dropped. The relay also pings every 30s, but this adds headroom.
#
# This block is for the default Application Load Balancer. If your environment
# uses a Classic Load Balancer, delete this and use the second block instead.
option_settings:
  aws:elbv2:loadbalancer:
    IdleTimeout: 3600

# Classic Load Balancer variant (uncomment if your env is Classic, remove above):
#  aws:elb:policies:
#    ConnectionSettingIdleTimeout: 3600
