// <<< generated:chromium-ui.js <<<

// ---- wiring (see PixelClientConfig above) ----
const CFG = window.PixelClientConfig || {};

const $ = (id)=>document.getElementById(id);
const enc = new TextEncoder(), dec = new TextDecoder();
function concat(...arrs){let n=0;for(const a of arrs)n+=a.length;const o=new Uint8Array(n);let p=0;for(const a of arrs){o.set(a,p);p+=a.length;}return o;}

// ---- state ----
let phase="idle", backoff=1000, pingTimer=null, pongTimer=null, sessionId=null;
let netRoute="wan"; // from hello.transport: "lan" means a local network, anything else a WAN route
// Deliberately ephemeral: the client keeps no browser storage or cookies.
// randomUUID needs a secure context; plain-http hosting gets the fallback.
const CLIENT_INSTANCE_ID=crypto.randomUUID?crypto.randomUUID():Array.from(crypto.getRandomValues(new Uint8Array(16)),(b)=>b.toString(16).padStart(2,"0")).join("");
const CLIENT_DEVICE=(()=>{ const p=(navigator.userAgentData&&navigator.userAgentData.platform)||navigator.platform||"Unknown platform"; const ua=navigator.userAgent||""; const b=/Edg\//.test(ua)?"Edge":/Chrome\//.test(ua)?"Chrome":/Safari\//.test(ua)?"Safari":/Firefox\//.test(ua)?"Firefox":"Browser"; return p+" · "+b; })();
let tabs=[], activeTab=null;
const view={w:1280,h:800,dpr:1};
const settings={jpeg:70,fps:60,scale:1,engine:"https://duckduckgo.com/?q=",paste:false,showUrls:true,theme:"system",showLatency:false,codec:"h264",hint:"motion"};
let frameCount=0, lastFpsAt=performance.now(), curFps=0;
let pendingBlob=null, decoding=false;
const canvas=$("screen"), ctx=canvas.getContext("2d",{alpha:false,desynchronized:true});
const video=$("rtcvideo");
let diagWindowAt=0, diagCount=0;

function diagnostic(kind,error,detail){
  const now=Date.now(); if(now-diagWindowAt>60000){diagWindowAt=now;diagCount=0;} if(++diagCount>30)return;
  const message=String(error&&error.message||error||"").slice(0,2000);
  const stack=String(error&&error.stack||"").slice(0,6000);
  const record={kind,message,stack,detail:detail||{},phase,codec:settings.codec};
  try{console.error("pixel-client",record);}catch(_){}
  if(phase==="open"||phase==="manage") send({t:"diag",kind,message,stack,detail:{...(detail||{}),phase,codec:settings.codec}});
}

function setOverlay(show,title,msg,spin){ const ov=$("overlay"); if(!show){ov.classList.add("hidden");return;}
  ov.classList.remove("hidden"); $("ov-title").textContent=title||""; $("ov-msg").textContent=msg||""; $("ov-spin").style.display=spin===false?"none":"block"; $("ov-extra").replaceChildren(); }
function toast(t){const el=$("toast");el.textContent=t;el.classList.remove("hidden");clearTimeout(el._t);el._t=setTimeout(()=>el.classList.add("hidden"),2600);}

// ================= connection =================
// Everything transport-specific lives in PixelClientConfig.connect (above).
// Each attempt gets its own record, so late events from a transport that a
// reconnect has already replaced are ignored.
let conn=null, reconnectTimer=null;
function connect(){
  phase="connecting"; setOverlay(true,"Connecting…","Establishing a session.");
  const c={t:null,open:false,closed:false,early:false};
  conn=c;
  const events={
    open:()=>onOpen(c),
    message:(data)=>onMessage(c,data),
    close:(code,reason)=>onClosed(c,code,reason),
  };
  let t;
  try{ t=CFG.connect(events); }catch(e){ diagnostic("transport_connect",e); onClosed(c,0,"connect threw"); return; }
  if(!t||typeof t.send!=="function"||typeof t.close!=="function"){ fatal("PixelClientConfig.connect() must return {send, close}."); return; }
  c.t=t;
  if(c.early) onOpen(c);   // the transport opened before connect() returned
}
function onClosed(c,code,reason){
  if(c!==conn||c.closed) return;
  c.closed=true; c.open=false; stopPing();
  if(phase==="fatal") return;
  code=Number(code)||0;
  if(code!==1000&&code!==1001) diagnostic("transport_close",reason||"closed",{code});
  if(code===4401){ fatal("Access was rejected or revoked."); return; }
  if(code===4409){ phase="stopped"; setOverlay(true,"Session busy","This session is open elsewhere.",false); return; }
  if(code===4429){ scheduleReconnect("Too many attempts","Please wait.",60000); return; }
  if(code===4503){ scheduleReconnect("Server full","All sessions are in use."); return; }
  scheduleReconnect();
}
// The client ends the connection itself (ping timeout, unreadable message).
function dropConn(reason){ const c=conn; if(!c||c.closed) return; try{c.t&&c.t.close();}catch(_){} onClosed(c,4000,reason); }
function scheduleReconnect(title,msg,minWait){ phase="reconnect";
  const wait=Math.max(minWait||0,Math.min(backoff,10000)*(0.7+Math.random()*0.6));
  setOverlay(true,title||"Reconnecting…",(msg?msg+" ":"")+"Retrying in "+Math.round(wait/1000)+"s.");
  reconnectTimer=setTimeout(()=>{ reconnectTimer=null; if(phase!=="fatal") connect(); },wait);
  backoff=Math.min(backoff*2,10000); }
function fatal(msg){ phase="fatal";
  if(reconnectTimer){ clearTimeout(reconnectTimer); reconnectTimer=null; }
  const c=conn; if(c&&!c.closed){ c.closed=true; c.open=false; stopPing(); try{c.t&&c.t.close();}catch(_){} }
  setOverlay(true,"Cannot connect",msg,false); }

async function onOpen(c){
  if(c!==conn||c.closed||c.open) return;
  if(!c.t){ c.early=true; return; }
  c.open=true; phase="auth";
  lastDrawnSeq=0; pendingBlob=null; pendingSeq=0;
  resetDecoder(); vdecErrors=0;
  let extra=null;
  try{ if(typeof CFG.auth==="function") extra=await CFG.auth(); }
  catch(e){ diagnostic("auth_fields",e); fatal("Could not get credentials."); return; }
  if(c!==conn||c.closed) return;
  send({...(extra&&typeof extra==="object"?extra:{}),t:"auth",proto:1,session:sessionId||undefined,client:{id:CLIENT_INSTANCE_ID,device:CLIENT_DEVICE}});
}
function onMessage(c,data){
  if(c!==conn||c.closed) return;
  try{
    if(typeof data==="string"){ onControl(JSON.parse(data)); return; }
    const plain=ArrayBuffer.isView(data)?new Uint8Array(data.buffer,data.byteOffset,data.byteLength):new Uint8Array(data);
    if(plain.length===0) return;
    if(plain[0]===0x01 || plain[0]===0x02){ onFrame(plain); return; }
    if(plain[0]===0x00){ onControl(JSON.parse(dec.decode(plain.subarray(1)))); return; }
  }catch(e){ diagnostic("message",e,{bytes:data&&(data.byteLength||data.length)}); dropConn("bad_message"); }
}
function send(obj){ const c=conn; if(!c||!c.open||c.closed) return;
  try{ c.t.send(concat(new Uint8Array([0x00]),enc.encode(JSON.stringify(obj)))); }
  catch(e){ try{console.error("pixel-client send",e);}catch(_){} } }

window.addEventListener("error",(e)=>diagnostic("window_error",e.error||e.message,{line:e.lineno,col:e.colno}));
window.addEventListener("unhandledrejection",(e)=>diagnostic("unhandled_rejection",e.reason));

// ================= control =================
function onControl(m){ switch(m.t){
  case "hello": phase="open"; backoff=1000; sessionId=m.session; netRoute=m.transport==="lan"?"lan":"wan"; setOverlay(false); canvas.focus(); rtcReset(); setRemoteCursor("default");
    sentView.w=0; sentView.h=0; sentView.dpr=0;
    tabs=m.tabs||[]; activeTab=m.active; renderTabs(); ensureTab(); startPing(); sendView(true); sendQuality(); sendCodec(); startCodecWatch();
    if(m.rtc && settings.hint!=="motion") send({t:"rtc.hint",hint:settings.hint}); break;
  // WebRTC signaling, optional (see the WebRTC media path below)
  case "rtc.offer": rtcOffer(m); break;
  case "rtc.ice": if(rtc.pc && m.cand) rtc.pc.addIceCandidate(m.cand).catch((e)=>diagnostic("rtc_ice",e)); break;
  case "rtc.state": if(m.state==="off") rtcFallback(m.reason||"server",true); break;
  case "tabs": tabs=m.tabs||[]; activeTab=m.active; renderTabs(); ensureTab(); break;
  case "slots": if(m.used>=m.max) toast("Sessions: "+m.used+" of "+m.max); break;
  case "full": renderSessionManager(m); break;
  case "codec":
    if(settings.codec!==m.codec) resetDecoder();
    settings.codec=m.codec;
    if(m.codec!=="h264" && m.reason) toast("Video codec unavailable on the server; using JPEG");
    break;
  // the server's governor can step the frame rate down (or back up) on its own
  case "q": if(!m.auto) settings.fps=m.fps; if(m.jpeg) settings.jpeg=m.jpeg;
      if(!menuPop.classList.contains("hidden")) openMenu(); break;
  case "dialog": showDialog(m); break;
  case "cursor": setRemoteCursor(m.c); break;
  case "err": diagnostic("server_error",m.msg||m.code,m); toast(m.msg||m.code||"Error"); if(m.code==="browser_crashed"||m.code==="session_expired") sessionId=null; break;
  case "pong": if(pongTimer){clearTimeout(pongTimer);pongTimer=null;}
    if(lastPingAt){ lat.rtt=performance.now()-lastPingAt; lastPingAt=0; updateLatencyHud(); } break;
} }

function formatAge(ts){ const sec=Math.max(0,Math.round((Date.now()-Number(ts||Date.now()))/1000)); if(sec<60)return sec+"s"; const min=Math.floor(sec/60); if(min<60)return min+"m"; const hr=Math.floor(min/60); return hr<24?hr+"h "+(min%60)+"m":Math.floor(hr/24)+"d "+(hr%24)+"h"; }
function renderSessionManager(m){
  phase="manage"; backoff=1000; startPing();
  const list=Array.isArray(m.sessions)?m.sessions:[];
  setOverlay(true,"Server full",(m.used||list.length)+" of "+(m.max||list.length)+" sessions are running. Disconnect one to use this client.",false);
  const root=$("ov-extra");
  if(!list.length){ const p=document.createElement("p"); p.textContent="No sessions were returned. Refresh to try again."; root.appendChild(p); }
  for(const s of list){
    const row=document.createElement("div"); row.className="session-row";
    const top=document.createElement("div"); top.className="session-top";
    const name=document.createElement("div"); name.className="session-name"; name.textContent=s.device||"Unknown device"; top.appendChild(name);
    const route=document.createElement("span"); route.className="session-route"; route.textContent=s.transport==="lan"?"LAN":"Remote"; top.appendChild(route); row.appendChild(top);
    const detail=document.createElement("div"); detail.className="session-detail";
    detail.textContent=(s.ip||"unknown address")+" · connected "+formatAge(s.connectedAt)+" ago · "+(s.status||"connected")+" · "+(s.codec||"codec unknown"); row.appendChild(detail);
    const page=document.createElement("div"); page.className="session-detail"; page.textContent=(s.title||"New Tab")+(s.url?" — "+s.url:""); row.appendChild(page);
    const actions=document.createElement("div"); actions.className="session-actions";
    const id=document.createElement("span"); id.className="session-detail"; id.textContent="Session "+String(s.id||"").slice(0,8); actions.appendChild(id);
    const button=document.createElement("button"); button.type="button"; button.textContent="Disconnect and use slot";
    button.addEventListener("click",()=>{ document.querySelectorAll(".session-actions button").forEach((b)=>b.disabled=true); button.textContent="Disconnecting…"; $("ov-msg").textContent="Closing that browser and starting a new session here…"; send({t:"session.disconnect",id:s.id}); });
    actions.appendChild(button); row.appendChild(actions); root.appendChild(row);
  }
  const refresh=document.createElement("button"); refresh.id="manager-refresh"; refresh.type="button"; refresh.textContent="Refresh list"; refresh.onclick=()=>send({t:"sessions.list"}); root.appendChild(refresh);
}

// ================= frames =================
// The server sends a monotonically increasing sequence in the 4 bytes after the
// type byte. Anything not newer than what is already on screen is stale by
// definition -- drawing it would show the past after the present.
let lastDrawnSeq=0, pendingSeq=0;

// ---- H.264 path (WebCodecs) -------------------------------------------------
// JPEG sends every pixel every frame, which is why video and games cost ~34
// Mbit/s. H.264 codes only what changed. Unlike the JPEG path we must NOT drop
// encoded frames: a delta frame references the one before it, so the server
// throttles before its encoder instead and the client decodes everything.
let vdec=null, vdecReady=false, vdecErrors=0;
const HAS_WEBCODECS = typeof window.VideoDecoder === "function" &&
                      typeof window.EncodedVideoChunk === "function";

function resetDecoder(){
  try{ if(vdec && vdec.state!=="closed") vdec.close(); }catch(e){}
  vdec=null; vdecReady=false;
}
function closeVisual(v){ try{ v&&v.close(); }catch(e){} }
// Paint on decoder output, not on the next animation frame. The compositor
// shows the canvas at the next vsync either way; waiting for rAF first only
// added half a frame on average. Frames are already newest-wins upstream
// (server pending slot, single JPEG decode, in-order H.264), so there is
// nothing to coalesce here.
function queuePresent(image,seq,h264){ paintFrame(image,seq,h264); }
function countFrame(){
  frameCount++; const now=performance.now();
  const elapsed=now-lastFpsAt;
  if(elapsed>=1000){ curFps=Math.round(frameCount*1000/elapsed); frameCount=0; lastFpsAt=now;
    const lf=$("livefps"); if(lf) lf.textContent=curFps+" fps"; updateLatencyHud(); }
}
function paintFrame(image,seq,h264){
  try{
    const w=image.displayWidth||image.width, h=image.displayHeight||image.height;
    if(canvas.width!==w||canvas.height!==h){ canvas.width=w; canvas.height=h; }
    ctx.drawImage(image,0,0); syncBlank(); noteFrame();
    if(h264) h264Painted++;
    countFrame();
    if(seq>lastDrawnSeq) lastDrawnSeq=seq;
    // JPEG uses a viewer draw-ack window. H.264 is regulated solely by socket
    // backpressure and bitrate, because every delta must reach the decoder.
    if(!h264 && seq) send({t:"fa",seq});
  } finally { closeVisual(image); }
}
function avcCodecForAnnexB(data){
  for(let i=0;i+7<data.length;i++){
    let n=0;
    if(data[i]===0&&data[i+1]===0&&data[i+2]===1)n=3;
    else if(data[i]===0&&data[i+1]===0&&data[i+2]===0&&data[i+3]===1)n=4;
    if(n&&((data[i+n]&31)===7)){
      return "avc1."+[data[i+n+1],data[i+n+2],data[i+n+3]].map(v=>v.toString(16).padStart(2,"0")).join("").toUpperCase();
    }
  }
  return "avc1.42E01E";
}
function ensureDecoder(codec="avc1.42E01E"){
  if(vdec) return vdec;
  try{
    vdec=new VideoDecoder({
      output:(frame)=>{
        const seq=Math.max(0,Math.round(Number(frame.timestamp||0)/1000))>>>0;
        queuePresent(frame,seq,true);
      },
      error:(e)=>{
        vdecErrors++;
        diagnostic("video_decoder_error",e,{errors:vdecErrors,received:h264Recv,painted:h264Painted});
        resetDecoder();
        // Two failures is enough: stop guessing and go back to a codec we know
        // decodes everywhere.
        if(vdecErrors>=2){ send({t:"codec",codec:"jpeg"}); toast("Video codec unavailable; using JPEG"); }
      }
    });
    // No `description` means Annex-B, which is what the server emits.
    vdec.configure({codec,optimizeForLatency:true});
    vdec._codec=codec;
    vdecReady=true;
  }catch(e){ diagnostic("video_decoder_configure",e); resetDecoder(); send({t:"codec",codec:"jpeg"}); }
  return vdec;
}

function onFrame(plain){
  const type=plain[0];
  const seq=(plain[1]<<24|plain[2]<<16|plain[3]<<8|plain[4])>>>0;
  if(seq!==0 && seq<=lastDrawnSeq) return;                 // stale, drop it

  if(type===0x02){
    h264Recv++;
    const key=(plain[5]&1)===1;
    const payload=plain.subarray(6);
    const streamCodec=key?avcCodecForAnnexB(payload):null;
    if(key&&vdec&&vdec._codec!==streamCodec) resetDecoder();
    const d=ensureDecoder(streamCodec||undefined);
    if(!d||!vdecReady) return;
    // Nothing decodes before the first keyframe; wait for one rather than
    // feeding the decoder deltas it cannot resolve.
    if(!key && !d._started){
      if(!d._askedKf){ d._askedKf=true; send({t:"kf"}); }   // request an IDR once
      return;
    }
    if(key){ d._started=true; h264Painted=Math.max(h264Painted,h264Recv-1); }
    try{
      d.decode(new EncodedVideoChunk({
        type:key?"key":"delta",
        timestamp:seq*1000,          // microseconds; only ordering matters here
        data:payload,
      }));
    }catch(e){ diagnostic("video_decode_submit",e,{seq,key,bytes:plain.length-6}); resetDecoder(); }
    return;
  }

  const blob=new Blob([plain.subarray(5)],{type:"image/jpeg"});
  // Only one decode at a time, and only the newest frame waits its turn.
  if(decoding){ pendingBlob=blob; pendingSeq=seq; return; }
  drawBlob(blob,seq);
}
function drawBlob(blob,seq){ decoding=true; createImageBitmap(blob).then((bmp)=>{
    queuePresent(bmp,seq,false);
    decoding=false;
    if(pendingBlob){ const b=pendingBlob, q=pendingSeq; pendingBlob=null; pendingSeq=0; drawBlob(b,q); }
  }).catch((e)=>{ diagnostic("jpeg_decode",e,{seq,bytes:blob.size}); decoding=false; pendingBlob=null; pendingSeq=0; }); }

// ================= WebRTC media path =================
// Optional. The server offers an H.264 track (rtc.offer). Offer, answer and
// candidates travel over the channel you wired in, and DTLS verifies the peer
// certificate against the fingerprint in that signaled SDP, so the media path
// is exactly as trustworthy as that channel. Input goes back over two
// DataChannels on the same UDP path. If anything fails, the frame stream over
// your channel takes over and the server is told so.
const rtc={pc:null,fast:null,rel:null,receiver:null,live:false,timer:null,disconnectTimer:null,statsTimer:null,pair:""};
let vfcId=0;
function rtcReset(){
  if(rtc.timer){ clearTimeout(rtc.timer); rtc.timer=null; }
  if(rtc.disconnectTimer){ clearTimeout(rtc.disconnectTimer); rtc.disconnectTimer=null; }
  if(rtc.statsTimer){ clearInterval(rtc.statsTimer); rtc.statsTimer=null; }
  if(rtc.pc){ try{ rtc.pc.close(); }catch(e){} }
  rtc.pc=null; rtc.fast=null; rtc.rel=null; rtc.receiver=null; rtc.live=false; rtc.pair="";
  stopVideoFrames();
  try{ video.srcObject=null; }catch(e){}
  video.hidden=true; canvas.style.opacity="";
}
async function rtcOffer(m){
  rtcReset();
  if(typeof RTCPeerConnection!=="function"){ send({t:"rtc.state",state:"failed",reason:"no_webrtc"}); return; }
  const pc=new RTCPeerConnection({iceServers:Array.isArray(m.ice)?m.ice:[],bundlePolicy:"max-bundle",rtcpMuxPolicy:"require"});
  rtc.pc=pc;
  pc.ontrack=(e)=>{
    const r=e.receiver;
    rtc.receiver=r;
    // WAN delivery needs a small cushion. Zero is excellent on a clean LAN,
    // but gives a WAN route no requested protection from varying packet
    // spacing. Thirty milliseconds is under two 60 Hz frames and is only
    // applied off the LAN.
    const targetMs=netRoute==="lan"?0:30;
    try{ if("jitterBufferTarget" in r) r.jitterBufferTarget=targetMs; }catch(_){}
    try{ if("playoutDelayHint" in r) r.playoutDelayHint=targetMs/1000; }catch(_){}
    video.srcObject=e.streams[0]||new MediaStream([e.track]);
    video.play().catch(()=>{});
  };
  pc.ondatachannel=(e)=>{ const ch=e.channel; if(ch.label==="input-fast") rtc.fast=ch; else if(ch.label==="input") rtc.rel=ch; };
  pc.onicecandidate=(e)=>{ if(e.candidate) send({t:"rtc.ice",cand:e.candidate.toJSON()}); };
  pc.onconnectionstatechange=()=>{
    if(pc!==rtc.pc) return;
    if(pc.connectionState==="connected"){
      if(rtc.disconnectTimer){ clearTimeout(rtc.disconnectTimer); rtc.disconnectTimer=null; }
      rtcLive(pc);
    }else if(pc.connectionState==="disconnected"){
      // Brief route changes recover on their own; a connection that remains
      // disconnected otherwise left a permanently frozen <video> because it
      // can take much longer to transition to "failed".
      if(!rtc.disconnectTimer) rtc.disconnectTimer=setTimeout(()=>{ if(pc===rtc.pc&&pc.connectionState==="disconnected") rtcFallback("ice_disconnected"); },4000);
    }else if(pc.connectionState==="failed") rtcFallback("ice_failed");
  };
  // Not connected within 6 s: fall back rather than stare at a black frame.
  rtc.timer=setTimeout(()=>{ if(!rtc.live) rtcFallback("timeout"); },6000);
  try{
    await pc.setRemoteDescription({type:"offer",sdp:String(m.sdp||"")});
    const ans=await pc.createAnswer();
    await pc.setLocalDescription(ans);
    if(pc!==rtc.pc) return;
    send({t:"rtc.answer",sdp:pc.localDescription.sdp});
  }catch(e){ diagnostic("rtc_negotiate",e); rtcFallback("negotiate_failed"); }
}
async function rtcPairType(pc){
  try{
    const st=await pc.getStats(); let out="?";
    st.forEach((r)=>{ if(r.type==="candidate-pair"&&r.nominated&&r.state==="succeeded"){
      const l=st.get(r.localCandidateId), rm=st.get(r.remoteCandidateId);
      out=(l?l.candidateType:"?")+"/"+(rm?rm.candidateType:"?"); } });
    return out;
  }catch(e){ return "?"; }
}
async function rtcLive(pc){
  if(rtc.timer){ clearTimeout(rtc.timer); rtc.timer=null; }
  if(rtc.disconnectTimer){ clearTimeout(rtc.disconnectTimer); rtc.disconnectTimer=null; }
  if(!rtc.live){
    rtc.live=true;
    video.hidden=false; canvas.style.opacity="0";
    startVideoFrames(); startRtcStats(pc);
  }
  rtc.pair=await rtcPairType(pc);
  if(pc!==rtc.pc) return;
  send({t:"rtc.state",state:"connected",pair:rtc.pair});
  updateLatencyHud();
}
function rtcFallback(reason,fromServer){
  const was=rtc.live, had=!!rtc.pc;
  const state=rtc.pc?rtc.pc.connectionState:"none", iceState=rtc.pc?rtc.pc.iceConnectionState:"none";
  rtcReset();
  if(!had) return; // server and client timers may report the same failure
  if(!fromServer && phase==="open") send({t:"rtc.state",state:"failed",reason});
  diagnostic("rtc_fallback",reason,{wasLive:was,route:netRoute,state,iceState});
  toast(was?"Video link dropped; using the frame stream":"Direct video unavailable; using the frame stream");
  updateLatencyHud();
}
// Frame rate and input-to-frame for the HUD come from the video element's own
// presentation callback while WebRTC is live.
function startVideoFrames(){
  stopVideoFrames();
  if(typeof video.requestVideoFrameCallback!=="function") return;
  const tick=()=>{ vfcId=video.requestVideoFrameCallback(()=>{ noteFrame(); countFrame(); if(rtc.live) tick(); }); };
  tick();
}
function stopVideoFrames(){ if(vfcId && video.cancelVideoFrameCallback) video.cancelVideoFrameCallback(vfcId); vfcId=0; }
function startRtcStats(pc){
  if(rtc.statsTimer) clearInterval(rtc.statsTimer);
  const sample=async()=>{
    if(pc!==rtc.pc||!rtc.live) return;
    try{
      const st=await pc.getStats(); let v=null;
      st.forEach((r)=>{ if(r.type==="inbound-rtp"&&r.kind==="video") v=r; });
      if(!v) return;
      const emitted=Number(v.jitterBufferEmittedCount||0);
      send({t:"rtc.stats",fps:v.framesPerSecond,received:v.framesReceived,decoded:v.framesDecoded,
        dropped:v.framesDropped,lost:v.packetsLost,jitterMs:Number(v.jitter||0)*1000,
        bufferMs:emitted?Number(v.jitterBufferDelay||0)*1000/emitted:0,
        freezes:v.freezeCount,freezeSeconds:v.totalFreezesDuration,
        decoder:String(v.decoderImplementation||"").slice(0,120),w:v.frameWidth,h:v.frameHeight});
    }catch(e){}
  };
  sample(); rtc.statsTimer=setInterval(sample,5000);
}
// Input takes the UDP path when it is up: moves and wheel on the lossy channel
// (the next one supersedes), everything else on the reliable one.
function sendInput(obj){
  if(rtc.live){
    const fast=(obj.t==="w" || (obj.t==="m" && obj.k==="move"));
    const ch=fast?(rtc.fast||rtc.rel):(rtc.rel||rtc.fast);
    if(ch && ch.readyState==="open"){ try{ ch.send(JSON.stringify(obj)); return; }catch(e){} }
  }
  send(obj);
}

// ================= viewport =================
function measure(){ const s=$("stage"); const w=Math.max(320,Math.round(s.clientWidth)), h=Math.max(200,Math.round(s.clientHeight));
  view.w=w; view.h=h; view.dpr=settings.scale; canvas.style.width=w+"px"; canvas.style.height=h+"px";
  video.style.width=w+"px"; video.style.height=h+"px"; }
let viewTimer=null;
const sentView={w:0,h:0,dpr:0};
function commitView(){
  if(sentView.w===view.w&&sentView.h===view.h&&sentView.dpr===view.dpr) return;
  sentView.w=view.w; sentView.h=view.h; sentView.dpr=view.dpr;
  send({t:"view",w:view.w,h:view.h,dpr:view.dpr});
}
function sendView(now){
  measure();
  if(viewTimer){clearTimeout(viewTimer);viewTimer=null;}
  if(now){ commitView(); return; }
  if(sentView.w===view.w&&sentView.h===view.h&&sentView.dpr===view.dpr) return;
  // Let browser-toolbar and window animations settle before the remote
  // viewport is resized. A server should coalesce too, but suppressing the
  // burst here avoids needless control traffic.
  viewTimer=setTimeout(()=>{viewTimer=null;commitView();},netRoute==="lan"?250:500);
}
function sendQuality(){ send({t:"q",jpeg:settings.jpeg,fps:settings.fps}); }

// ---- codec health -----------------------------------------------------------
// The mistake worth not repeating: "no frames arrived" is NOT a fault. Chrome
// emits a screencast frame only when something changes, so a still page -- a
// blank new tab above all -- legitimately produces nothing at all. Downgrading
// on silence meant the codec fell back the moment you stopped moving.
//
// A real fault looks different: chunks ARRIVE but never paint. That is a
// decoder that cannot resolve what it is being given, and the first remedy is a
// fresh keyframe, not a downgrade.
let h264Recv=0, h264Painted=0, h264Stall=0, codecWatch=null;
function startCodecWatch(){
  if(codecWatch) clearInterval(codecWatch);
  h264Recv=0; h264Painted=0; h264Stall=0;
  codecWatch=setInterval(()=>{
    if(phase!=="open" || settings.codec!=="h264") return;
    if(h264Recv===0) return;                     // nothing sent: a static page
    const backlog=h264Recv-h264Painted;
    if(backlog<8){ h264Stall=0; return; }        // decoding fine
    h264Stall++;
    if(h264Stall===2){ diagnostic("video_decoder_stall","H.264 chunks arrived without painted frames",{backlog,received:h264Recv,painted:h264Painted,recovery:"keyframe"}); send({t:"kf"}); }
    if(h264Stall>=5){                            // still nothing after a keyframe
      diagnostic("video_decoder_fallback","decoder did not recover after keyframe",{backlog,received:h264Recv,painted:h264Painted,recovery:"jpeg"});
      settings.codec="jpeg"; resetDecoder(); send({t:"codec",codec:"jpeg"});
      toast("Video decoder not keeping up; switched to JPEG");
      h264Stall=0;
    }
  }, 1500);
}

// Ask the browser whether it can actually decode H.264 before requesting it.
// Optimistically switching and discovering configure() throws costs a round
// trip and a visible stall; WebCodecs is also absent entirely in headless.
async function sendCodec(){
  let ok=false;
  if(HAS_WEBCODECS && settings.codec==="h264"){
    try{
      const r=await VideoDecoder.isConfigSupported({codec:"avc1.42E01E",optimizeForLatency:true});
      ok=!!(r&&r.supported);
    }catch(e){ diagnostic("codec_support_check",e); ok=false; }
    if(!ok){ diagnostic("codec_unsupported","WebCodecs H.264 baseline is unavailable"); settings.codec="jpeg"; }
  }
  send({t:"codec",codec:ok?"h264":"jpeg"});
}
window.addEventListener("resize",()=>sendView(false));


// Toolbar/tab icons at the sizes Chromium uses:
//   kToolbarButtonIconSize (kDefaultIconSizeChromeRefresh) = 20
//   kLocationBarIconSize = 16, kLocationBarTrailingIconSize = 20
//   kTabCloseButtonSize = 14
function paintIcons(){
  const set=(id,name,px)=>{const el=$(id); if(el) el.innerHTML=icon(name,px);};
  set("back","back",20); set("fwd","fwd",20); set("reload","reload",20);
  set("newtab","add",20); set("star","star",16); set("ext","ext",20);
  set("avatar","avatar",20); set("menu","menu",20);
  set("tabsearch","chevron",16); set("lead","search",16);
}


// Chrome is never in a no-tab state: the window always holds at least one tab,
// and closing the last one opens a New Tab rather than emptying the strip.
// Until the server reports real tabs we show a local placeholder so the strip
// is never blank on open.
function ensureTab(){
  if(!tabs || tabs.length===0){
    tabs=[{id:activeTab||-1,title:"New Tab",url:"about:blank",loading:false}];
    if(activeTab==null) activeTab=-1;
    renderTabs();
  }
}
function closeTab(id){
  if(tabs.length<=1){ send({t:"nav",url:"about:blank"}); return; }  // keep one tab, blank it
  send({t:"tab.close",id:id});
}

// A tab sitting on about:blank is a New Tab, and Chrome labels it that way
// rather than showing the URL.
// Only an explicit about:blank counts. A missing url must NOT read as blank:
// treating undefined that way would leave the new tab surface covering a page
// that had actually loaded.
function isBlankUrl(u){ return u==="about:blank" || u==="about:newtab"; }
function tabLabel(t){
  if(isBlankUrl(t.url)) return "New Tab";
  return t.title || prettyUrl(t.url) || "New Tab";
}
// Show the local New Tab surface whenever the active tab is blank, and hide the
// streamed canvas so the remote about:blank (a white page) never flashes through.
function syncBlank(){
  const at = tabs.find((t)=>t.id===activeTab);
  const blank = !!at && isBlankUrl(at.url);
  // The overlay is opaque and sits above the canvas, so showing it is enough.
  // Hiding the canvas as well gave a way for a page to become permanently
  // invisible if a tab update ever arrived without a url.
  $("blank").hidden = !blank;
  if(blank){
    const i=$("ntpicon"); if(i && !i.innerHTML) i.innerHTML=icon("search",20);
    const mk=$("ntpmark"); if(mk && !mk.innerHTML) mk.innerHTML=SVGS.google_logo||"";
  }
}

// ================= tab strip =================
// Direct port of HorizontalTabStyleViews::GetPath() (Chromium
// chrome/browser/ui/views/tabs/common/horizontal_tab_style_views.cc).
// Skia kCW -> SVG sweep-flag 1, kCCW -> 0; kSmall_ArcSize -> large-arc-flag 0.
const TAB_EXT = 12;   // TabStyle::GetBottomCornerRadius()
const TAB_TOPR = 10;  // TabStyle::GetTopCornerRadius()
const TAB_PAD = 6;    // kTabStripPadding
const TAB_H = 35;     // kTabHeight (34 + kTabstripToolbarOverlap 1)
const TAB_OVERLAP_ADJ = 1; // kTabstripToolbarOverlap

// GetTopCornerRadiusForWidth: keep at least a third of the top flat.
function topRadiusFor(w){
  const top = w - TAB_TOPR * 2;
  return Math.max(0, Math.min(TAB_TOPR, top / 3));
}

// The active tab: flared bottom corners that merge into the toolbar.
function activeTabPath(w, h){
  const r = topRadiusFor(w);
  const e = TAB_EXT;
  const left = 0, right = w;
  const tabLeft = left + e, tabRight = right - e;
  const tabTop = TAB_PAD;
  const extendedBottom = h;
  const tabBottom = extendedBottom - TAB_OVERLAP_ADJ;
  return [
    `M ${left} ${extendedBottom}`,
    `L ${left} ${tabBottom}`,
    `A ${e} ${e} 0 0 0 ${tabLeft} ${tabBottom - e}`,   // bottom-left, CCW, flares out
    `L ${tabLeft} ${tabTop + r}`,
    `A ${r} ${r} 0 0 1 ${tabLeft + r} ${tabTop}`,      // top-left, CW
    `L ${tabRight - r} ${tabTop}`,
    `A ${r} ${r} 0 0 1 ${tabRight} ${tabTop + r}`,     // top-right, CW
    `L ${tabRight} ${tabBottom - e}`,
    `A ${e} ${e} 0 0 0 ${right} ${tabBottom}`,         // bottom-right, CCW, flares out
    `L ${right} ${extendedBottom}`,
    'Z',
  ].join(' ');
}

// Inactive hover / selected: the "detached squarcle" the source describes -
// a plain rounded rect, inset by the extension radius on both sides.
function squarclePath(w){
  const r = topRadiusFor(w);
  const e = TAB_EXT;
  const x = e, y = TAB_PAD, ww = w - 2 * e;
  const hh = TAB_H - TAB_PAD - TAB_OVERLAP_ADJ;
  return `M ${x + r} ${y} h ${ww - 2 * r} a ${r} ${r} 0 0 1 ${r} ${r}` +
         ` v ${hh - 2 * r} a ${r} ${r} 0 0 1 ${-r} ${r} h ${-(ww - 2 * r)}` +
         ` a ${r} ${r} 0 0 1 ${-r} ${-r} v ${-(hh - 2 * r)} a ${r} ${r} 0 0 1 ${r} ${-r} Z`;
}

// Paths depend on the rendered width, so they are rebuilt after layout.
function layoutTabShapes(){
  document.querySelectorAll("#tabs .tab").forEach((el)=>{
    const w = Math.round(el.getBoundingClientRect().width);
    const h = Math.round(el.getBoundingClientRect().height);
    if(!w || !h) return;
    const svg = el.querySelector("svg.shape"); if(!svg) return;
    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    const path = svg.firstElementChild;
    const active = el.classList.contains("active");
    path.setAttribute("d", active ? activeTabPath(w, h) : squarclePath(w));
  });
}

function renderTabs(){
  const wrap=$("tabs"); wrap.textContent="";
  tabs.forEach((t,i)=>{
    const el=document.createElement("div"); el.className="tab"+(t.id===activeTab?" active":"");
    if(t.id!==activeTab && i>0 && tabs[i-1].id!==activeTab) el.className+=" sepL";
    const svg=document.createElementNS("http://www.w3.org/2000/svg","svg");
    svg.setAttribute("class","shape"); svg.setAttribute("preserveAspectRatio","none");
    svg.appendChild(document.createElementNS("http://www.w3.org/2000/svg","path"));
    el.appendChild(svg);
    let fav;
    if(t.loading){ fav=document.createElement("div"); fav.className="spin"; }
    else if(t.favicon){
      // data: URI produced by the server; never a URL the viewer would fetch
      fav=document.createElement("img"); fav.className="fav real"; fav.src=t.favicon; fav.alt="";
      fav.onerror=()=>{ fav.removeAttribute("src"); fav.className="fav"; };
    } else { fav=document.createElement("div"); fav.className="fav"; }
    el.appendChild(fav);
    const ttl=document.createElement("div"); ttl.className="ttl";
    ttl.textContent=settings.showUrls?tabLabel(t):"Tab"; el.appendChild(ttl);
    const x=document.createElement("div"); x.className="cls"; x.title="Close";
    x.innerHTML=icon("close",14);   // kTabCloseButtonSize
    x.addEventListener("click",(e)=>{e.stopPropagation();closeTab(t.id);}); el.appendChild(x);
    el.addEventListener("click",()=>{ if(t.id!==activeTab) send({t:"tab.switch",id:t.id}); });
    wrap.appendChild(el);
  });
  layoutTabShapes();
  syncBlank();
  { const a=tabs.find((t)=>t.id===activeTab); if(a) checkSearchBlocked(a.url); }
  const at=tabs.find((t)=>t.id===activeTab);
  updateLead(at?at.url:"");
  if(at && document.activeElement!==$("url")){ $("url").value = settings.showUrls ? (at.url==="about:blank"?"":(at.url||"")) : ""; }
}
window.addEventListener("resize", layoutTabShapes);

let sorryWarned=false;
function checkSearchBlocked(url){
  if(!url) return;
  if(/^https:\/\/[^/]*google\.[^/]*\/sorry\//.test(url)){
    if(sorryWarned) return; sorryWarned=true;
    toast("Google is blocking searches from this server's IP. Switch engine in the menu \u2014 DuckDuckGo and Bing work.");
  } else if(!/google\.[^/]*\/sorry\//.test(url)) sorryWarned=false;
}

function prettyUrl(u){ try{ return new URL(u).host; }catch(e){ return u||""; } }
function updateLead(url){
  const lead=$("lead"); let secure=false; try{ secure=new URL(url).protocol==="https:"; }catch(e){}
  const blank = isBlankUrl(url);
  lead.innerHTML=icon(blank ? "search" : (secure ? "lock" : "info"), 16); // kLocationBarIconSize
}

$("ntpq").addEventListener("keydown",(e)=>{ e.stopPropagation();
  if(e.key!=="Enter") return;
  const d=toDestination($("ntpq").value.trim());
  if(d){ send({t:"nav",url:d}); $("ntpq").value=""; canvas.focus(); }
});

// ================= omnibox =================
const urlInput=$("url");
$("back").addEventListener("click",()=>send({t:"back"}));
$("fwd").addEventListener("click",()=>send({t:"fwd"}));
$("reload").addEventListener("click",()=>send({t:"reload"}));
$("newtab").addEventListener("click",()=>send({t:"tab.new"}));
urlInput.addEventListener("focus",()=>{$("omni").classList.add("focus");urlInput.select();});
urlInput.addEventListener("blur",()=>$("omni").classList.remove("focus"));
urlInput.addEventListener("keydown",(e)=>{ e.stopPropagation();
  if(e.key==="Enter"){ const d=toDestination(urlInput.value.trim()); if(d){ send({t:"nav",url:d}); canvas.focus(); } }
  else if(e.key==="Escape"){ canvas.focus(); } });
function toDestination(text){ if(!text) return null;
  if(/^https?:\/\//i.test(text)) return text;
  if(/^[a-z][a-z0-9+.-]*:/i.test(text)) return text;
  if(/^[^\s]+\.[^\s]{2,}(\/|$|:)/.test(text) && !/\s/.test(text)) return "https://"+text;
  return settings.engine+encodeURIComponent(text); }

// ================= input capture =================
// The remote page's cursor style, reported by the server as the pointer moves.
// Keywords only: a custom image cursor cannot be fetched here and falls back to
// the keyword the page listed after it, or to default.
const CURSORS=new Set(["default","none","context-menu","help","pointer","progress","wait","cell","crosshair","text","vertical-text","alias","copy","move","no-drop","not-allowed","grab","grabbing","all-scroll","col-resize","row-resize","n-resize","e-resize","s-resize","w-resize","ne-resize","nw-resize","se-resize","sw-resize","ew-resize","ns-resize","nesw-resize","nwse-resize","zoom-in","zoom-out"]);
function setRemoteCursor(v){
  let c="default";
  for(const tok of String(v||"").split(",")){ const t=tok.trim(); if(CURSORS.has(t)) c=t; }
  canvas.style.cursor=c;
}
function mods(e){ return (e.altKey?1:0)|((e.ctrlKey||e.metaKey)?2:0)|(e.shiftKey?8:0); }
function pos(e){ const r=canvas.getBoundingClientRect(); return {x:e.clientX-r.left,y:e.clientY-r.top}; }
let moveQueued=null, moveScheduled=false;
const heldKeys=new Map();   // code -> {key,code}, so focus loss can release them
function flushMove(){ if(moveQueued){ sendInput(moveQueued); moveQueued=null; } }
canvas.addEventListener("mousedown",(e)=>{ e.preventDefault(); canvas.focus(); noteInput(); heldButtons.add(e.button); const p=pos(e); sendInput({t:"m",k:"down",x:p.x,y:p.y,b:e.button,bs:e.buttons,mods:mods(e),n:e.detail}); });
// Release on WINDOW, not the canvas: press inside, drag out, release outside and
// the canvas never sees the mouseup -- the remote page would believe the button
// is still held. Matters for drag-select, sliders and anything game-like.
let heldButtons=new Set();
canvas.addEventListener("mouseup",(e)=>{ e.preventDefault(); });
window.addEventListener("mouseup",(e)=>{
  if(!heldButtons.has(e.button)) return;
  heldButtons.delete(e.button);
  const p=pos(e); sendInput({t:"m",k:"up",x:p.x,y:p.y,b:e.button,bs:e.buttons,mods:mods(e),n:e.detail});
});
canvas.addEventListener("mousemove",(e)=>{ const p=pos(e); moveQueued={t:"m",k:"move",x:p.x,y:p.y,b:0,bs:e.buttons,mods:mods(e),n:0};
  if(!moveScheduled){moveScheduled=true;requestAnimationFrame(()=>{moveScheduled=false;flushMove();});} });
canvas.addEventListener("contextmenu",(e)=>e.preventDefault());
let wheelQueued=null,wheelBurst=false;
canvas.addEventListener("wheel",(e)=>{ e.preventDefault(); let dx=e.deltaX,dy=e.deltaY;
  if(e.deltaMode===1){dx*=16;dy*=16;} else if(e.deltaMode===2){dx*=view.w;dy*=view.h;}
  const p=pos(e);
  if(!wheelBurst){
    // First event of a burst leaves synchronously. Waiting for the next
    // animation frame would cost a whole frame interval (~16ms at 60Hz) before
    // the scroll even reaches the wire; only trailing events need coalescing.
    noteInput();
    sendInput({t:"w",x:p.x,y:p.y,dx,dy,mods:mods(e)});
    wheelBurst=true;
    requestAnimationFrame(()=>{
      wheelBurst=false;
      if(wheelQueued){ sendInput(wheelQueued); wheelQueued=null; }
    });
    return;
  }
  // within the same frame: accumulate deltas rather than sending each one
  if(wheelQueued){ wheelQueued.dx+=dx; wheelQueued.dy+=dy; wheelQueued.x=p.x; wheelQueued.y=p.y; }
  else wheelQueued={t:"w",x:p.x,y:p.y,dx,dy,mods:mods(e)};
},{passive:false});
window.addEventListener("keydown",(e)=>{ if(document.activeElement===urlInput) return; const cmd=e.ctrlKey||e.metaKey;
  if(cmd&&!e.shiftKey&&e.key.toLowerCase()==="l"){ e.preventDefault(); urlInput.focus(); return; }
  if(cmd&&!e.shiftKey&&e.key.toLowerCase()==="t"){ e.preventDefault(); send({t:"tab.new"}); return; }
  if(cmd&&e.shiftKey&&(e.key==="]"||e.key==="}")){ e.preventDefault(); cycleTab(1); return; }
  if(cmd&&e.shiftKey&&(e.key==="["||e.key==="{")){ e.preventDefault(); cycleTab(-1); return; }
  if(cmd&&!e.shiftKey&&e.key.toLowerCase()==="r"){ e.preventDefault(); send({t:"reload"}); return; }
  if(e.key==="F5"){ e.preventDefault(); send({t:"reload"}); return; }
  if(e.key==="Tab"||e.key===" "||e.key.startsWith("Arrow")||e.key==="Backspace"||e.key==="Enter") e.preventDefault();
  heldKeys.set(e.code||e.key,{key:e.key,code:e.code});
  sendInput({t:"k",k:"down",key:e.key,code:e.code,mods:mods(e),rep:e.repeat}); },true);
window.addEventListener("keyup",(e)=>{ if(document.activeElement===urlInput) return;
  heldKeys.delete(e.code||e.key);
  sendInput({t:"k",k:"up",key:e.key,code:e.code,mods:mods(e)}); },true);

// Alt-tabbing away while a key is down means the keyup never arrives, and the
// remote page keeps the key held forever -- a character repeats endlessly, or a
// game keeps walking. Release everything still held whenever focus leaves.
function releaseHeld(){
  for(const rec of heldKeys.values()) sendInput({t:"k",k:"up",key:rec.key,code:rec.code,mods:0});
  heldKeys.clear();
  for(const b of heldButtons) sendInput({t:"m",k:"up",x:0,y:0,b:b,bs:0,mods:0,n:1});
  heldButtons.clear();
}
window.addEventListener("blur",releaseHeld);
document.addEventListener("visibilitychange",()=>{ if(document.hidden) releaseHeld(); });
canvas.addEventListener("compositionend",(e)=>{ if(e.data) sendInput({t:"txt",s:e.data}); });
window.addEventListener("paste",(e)=>{ if(document.activeElement===urlInput) return;
  if(!settings.paste){ toast("Paste to remote is off (enable in menu)"); return; }
  const t=(e.clipboardData||window.clipboardData).getData("text"); if(t) sendInput({t:"txt",s:t}); });
function cycleTab(dir){ if(!tabs.length) return; let i=tabs.findIndex((t)=>t.id===activeTab); i=(i+dir+tabs.length)%tabs.length; send({t:"tab.switch",id:tabs[i].id}); }
window.addEventListener("beforeunload",(e)=>{ if(phase==="open"){ e.preventDefault(); e.returnValue=""; } });

// ================= ping =================
let lastPingAt=0;
function startPing(){ stopPing(); pingTimer=setInterval(()=>{
  lastPingAt=performance.now(); send({t:"ping",ts:Date.now()});
  if(pongTimer) return; pongTimer=setTimeout(()=>{ pongTimer=null; dropConn("ping_timeout"); }, 10000); },
  settings.showLatency?2000:20000); }
function stopPing(){ if(pingTimer){clearInterval(pingTimer);pingTimer=null;} if(pongTimer){clearTimeout(pongTimer);pongTimer=null;} }

// ================= dialogs =================
function showDialog(m){ const modal=$("modal"); modal.classList.remove("hidden"); modal.textContent="";
  const box=document.createElement("div"); box.className="box";
  const h=document.createElement("h2"); h.textContent=({alert:"Alert",confirm:"Confirm",prompt:"Prompt",beforeunload:"Leave site?"})[m.kind]||"Dialog"; box.appendChild(h);
  const msg=document.createElement("div"); msg.className="msg"; msg.textContent=m.msg||""; box.appendChild(msg);
  let input=null; if(m.kind==="prompt"){ input=document.createElement("input"); input.type="text"; input.value=m.default||""; box.appendChild(input); }
  const row=document.createElement("div"); row.className="row";
  const close=(a)=>{ modal.classList.add("hidden"); send({t:"dialog",id:m.id,accept:a,text:input?input.value:undefined}); canvas.focus(); };
  if(m.kind!=="alert"){ const c=document.createElement("button"); c.className="cancel"; c.textContent="Cancel"; c.onclick=()=>close(false); row.appendChild(c); }
  const ok=document.createElement("button"); ok.className="ok"; ok.textContent="OK"; ok.onclick=()=>close(true); row.appendChild(ok);
  box.appendChild(row); modal.appendChild(box); (input||ok).focus(); }


// ---- appearance ----
// The palette is driven by data-theme on <html>: absent = follow the OS, which
// is what Chrome's "System default" does.
function applyTheme(){
  const r=document.documentElement;
  if(settings.theme==="system") r.removeAttribute("data-theme");
  else r.setAttribute("data-theme", settings.theme);
}

// ---- latency ----
// rtt   : control round trip, measured by the existing ping
// frame : input -> next frame, i.e. what a click actually costs you
const lat={rtt:0,frame:0,pendingInput:0,samples:[]};
function noteInput(){ if(!lat.pendingInput) lat.pendingInput=performance.now(); }
function noteFrame(){
  if(!lat.pendingInput) return;
  const d=performance.now()-lat.pendingInput; lat.pendingInput=0;
  lat.samples.push(d); if(lat.samples.length>30) lat.samples.shift();
  const s=[...lat.samples].sort((a,b)=>a-b); lat.frame=s[Math.floor(s.length/2)];
  updateLatencyHud();
}
function updateLatencyHud(){
  const h=$("lat"); if(!h) return;
  h.hidden=!settings.showLatency;
  if(settings.showLatency) h.textContent=Math.round(lat.rtt)+" ms rtt · "+Math.round(lat.frame)+" ms input\u2192frame · "+curFps+" fps · "+(rtc.live?"webrtc "+rtc.pair:"stream "+settings.codec);
  const m=$("livelat"); if(m) m.textContent=Math.round(lat.rtt)+" / "+Math.round(lat.frame)+" ms";
}

// ---- fullscreen ----
function toggleFullscreen(){
  const el=document.documentElement;
  if(!document.fullscreenElement){ (el.requestFullscreen||el.webkitRequestFullscreen||(()=>{})).call(el); }
  else { (document.exitFullscreen||document.webkitExitFullscreen||(()=>{})).call(document); }
}
document.addEventListener("fullscreenchange",()=>{ sendView(true); });

// ================= three-dot menu + settings =================
const menuPop=$("menu-pop");
$("menu").addEventListener("click",(e)=>{ e.stopPropagation(); menuPop.classList.contains("hidden")?openMenu():menuPop.classList.add("hidden"); });
document.addEventListener("click",()=>menuPop.classList.add("hidden"));
menuPop.addEventListener("click",(e)=>e.stopPropagation());
function mkItem(label,iconName,onclick,ph){ const d=document.createElement("div"); d.className="mi"+(ph?" ph":"");
  const ic=document.createElement("span"); ic.style.cssText="width:16px;height:16px;display:inline-flex;flex:0 0 16px";
  if(iconName) ic.innerHTML=icon(iconName,16);   // generated, constant markup
  d.appendChild(ic);
  const l=document.createElement("span"); l.textContent=label; d.appendChild(l);
  if(onclick&&!ph) d.addEventListener("click",()=>{ menuPop.classList.add("hidden"); onclick(); }); return d; }
function mkSet(label,node){ const d=document.createElement("div"); d.className="set"; const l=document.createElement("span"); l.textContent=label; d.appendChild(l); d.appendChild(node); return d; }
function openMenu(){
  menuPop.textContent="";
  menuPop.appendChild(mkItem("New tab","add",()=>send({t:"tab.new"})));
  menuPop.appendChild(mkItem("Reload","reload",()=>send({t:"reload"})));
  menuPop.appendChild(mkItem("History","history",null,true));
  menuPop.appendChild(mkItem("Downloads","download",null,true));
  menuPop.appendChild(mkItem(document.fullscreenElement?"Exit full screen":"Full screen","fullscreen",toggleFullscreen));
  menuPop.appendChild(document.createElement("hr"));
  const asec=document.createElement("div"); asec.className="sec"; asec.textContent="Appearance"; menuPop.appendChild(asec);
  const th=document.createElement("select");
  [["system","System default"],["light","Light"],["dark","Dark"]].forEach(([v,t])=>{
    const o=document.createElement("option"); o.value=v; o.textContent=t;
    if(v===settings.theme)o.selected=true; th.appendChild(o); });
  th.onchange=()=>{ settings.theme=th.value; applyTheme(); };
  menuPop.appendChild(mkSet("Theme",th));
  menuPop.appendChild(document.createElement("hr"));
  const sec=document.createElement("div"); sec.className="sec"; sec.textContent="Stream"; menuPop.appendChild(sec);
  const q=document.createElement("input"); q.type="range"; q.min=30;q.max=90;q.value=settings.jpeg;
  const qv=document.createElement("span"); qv.className="val"; qv.textContent=settings.jpeg; q.oninput=()=>{qv.textContent=q.value; settings.jpeg=+q.value; sendQuality();};
  const qwrap=document.createElement("span"); qwrap.style.cssText="display:flex;gap:8px;flex:1"; qwrap.appendChild(q); qwrap.appendChild(qv);
  menuPop.appendChild(mkSet("Quality",qwrap));
  const f=document.createElement("select"); [5,10,15,20,24,30,48,60].forEach((v)=>{const o=document.createElement("option");o.value=v;o.textContent=v+" fps";if(v==settings.fps)o.selected=true;f.appendChild(o);});
  f.onchange=()=>{settings.fps=+f.value; sendQuality();}; menuPop.appendChild(mkSet("Max frame rate",f));
  const sc=document.createElement("select"); [[1,"Standard"],[2,"Sharp (2×, 4× the pixels)"]].forEach(([v,t])=>{const o=document.createElement("option");o.value=v;o.textContent=t;if(v==settings.scale)o.selected=true;sc.appendChild(o);});
  sc.onchange=()=>{settings.scale=+sc.value; sendView(true);}; menuPop.appendChild(mkSet("Resolution",sc));
  // What the encoder gives up first under pressure: frame rate (reading) or sharpness (games).
  const hs=document.createElement("select"); [["motion","Smooth motion (games)"],["detail","Sharp text (reading)"]].forEach(([v,t])=>{const o=document.createElement("option");o.value=v;o.textContent=t;if(v===settings.hint)o.selected=true;hs.appendChild(o);});
  hs.onchange=()=>{settings.hint=hs.value; send({t:"rtc.hint",hint:settings.hint});}; menuPop.appendChild(mkSet("Priority",hs));
  const se=document.createElement("select"); [["https://duckduckgo.com/?q=","DuckDuckGo"],["https://www.google.com/search?q=","Google"],["https://www.bing.com/search?q=","Bing"]].forEach(([v,t])=>{const o=document.createElement("option");o.value=v;o.textContent=t;if(v===settings.engine)o.selected=true;se.appendChild(o);});
  se.onchange=()=>settings.engine=se.value; menuPop.appendChild(mkSet("Search engine",se));
  const pa=document.createElement("input"); pa.type="checkbox"; pa.checked=settings.paste; pa.onchange=()=>settings.paste=pa.checked; menuPop.appendChild(mkSet("Allow paste to remote",pa));
  const lt=document.createElement("input"); lt.type="checkbox"; lt.checked=settings.showLatency;
  lt.onchange=()=>{ settings.showLatency=lt.checked; updateLatencyHud(); if(phase==="open") startPing(); };
  menuPop.appendChild(mkSet("Show latency",lt));
  menuPop.appendChild(document.createElement("hr"));
  const stat=document.createElement("div"); stat.id="stat";
  const lf=document.createElement("span"); lf.id="livefps"; lf.textContent=curFps+" fps";
  const ll=document.createElement("span"); ll.id="livelat"; ll.textContent=Math.round(lat.rtt)+" / "+Math.round(lat.frame)+" ms";
  stat.append("Session \u00b7 ", (rtc.live?"WebRTC "+rtc.pair:"Stream "+settings.codec)+" \u00b7 ", lf, " \u00b7 ", ll);
  menuPop.appendChild(stat);
  menuPop.classList.remove("hidden");
}

// ================= boot =================
applyTheme(); paintIcons(); ensureTab(); measure(); $("blank").hidden=false;
if(typeof CFG.connect==="function") connect();
else { phase="unwired"; setOverlay(true,"Not connected","No server is wired up yet. Set PixelClientConfig.connect in this file.",false); }
})();
</script>
</body>
</html>
