<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; connect-src ws://100.117.142.127:8765; img-src blob: data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'">
<title>Browser</title>
<!--
  Pixel-streaming browser client. One self-contained file, no server built in.

  A remote Chromium renders the pages; this file draws its pixels and sends back
  mouse, wheel, keyboard, IME/paste, tab and navigation commands. It has no
  address, credentials or transport of its own. To use it:
    1. Fill in PixelClientConfig (the first script block in the body).
    2. Replace connect-src 'none' in the CSP above with your endpoint,
       e.g. connect-src wss://your-server.example
  Serve it over TLS or wire in a transport that is. Nothing here authenticates
  the server for you.

  This copy is wired to server.js next to it. Open it straight from disk and it
  connects to PIXEL_SERVER (listed in connect-src above) with PIXEL_TOKEN, which
  must match server.js's .pixel-token. This file now holds that token, so
  sharing the file shares access. server.js also serves the page on port 8081;
  that copy points PIXEL_SERVER and connect-src at the host it was loaded from,
  has the token blanked, and takes it from the #token link the server prints.

  FRAMING  one message = one Uint8Array; byte 0 is the type
    0x00  control  UTF-8 JSON {"t": ...}                            both ways
    0x01  JPEG     [seq u32 BE][JPEG]                               server -> client
    0x02  H.264    [seq u32 BE][flags u8, bit 0 = key][Annex-B access unit]
  seq rises by frame; a frame not newer than the one on screen is dropped.
  A string from the server is also accepted as control JSON.

  CLIENT -> SERVER
    auth        {proto:1, session?, client:{id, device}, ...PixelClientConfig.auth()}  first
    view        {w, h, dpr}         viewport in CSS px; at start and on resize
    q           {jpeg, fps}         quality settings
    codec       {codec}             "h264" | "jpeg", once decoder support is known
    kf          {}                  H.264 decoder needs a keyframe
    fa          {seq}               newest JPEG frame actually drawn (flow control)
    nav {url}   back  fwd  reload   tab.new  tab.close {id}  tab.switch {id}
    m           {k:"down"|"up"|"move", x, y, b, bs, mods, n}
    w           {x, y, dx, dy, mods}          deltas in px
    k           {k:"down"|"up", key, code, mods, rep}
    txt         {s}                 IME commit or paste
    dialog      {id, accept, text?}
    ping        {ts}
    diag        {kind, message, stack, detail}   client errors, for your logs
    rtc.answer {sdp}  rtc.ice {cand}  rtc.state {state, pair?, reason?}  rtc.stats {...}  rtc.hint {hint}
    sessions.list  session.disconnect {id}       from the "server full" screen
    x, y are CSS px from the viewport's top-left; mods: 1 alt, 2 ctrl or meta, 8 shift.

  SERVER -> CLIENT
    hello       {session, tabs, active, transport?, rtc?}   after auth; transport "lan"
                                                            drops the WAN jitter cushion
    tabs        {tabs:[{id, title, url, loading, favicon?}], active}   favicon: data: URI
    codec       {codec, reason?}    q {fps, jpeg?, auto?}   cursor {c}   pong {ts}
    dialog      {id, kind:"alert"|"confirm"|"prompt"|"beforeunload", msg, default?}
    err         {code, msg}         "browser_crashed" / "session_expired" drop the session id
    slots       {used, max}
    full        {used, max, sessions:[{id, device, transport, ip, connectedAt, status, codec, title, url}]}
    rtc.offer   {sdp, ice?}  rtc.ice {cand}  rtc.state {state:"off", reason?}

  WEBRTC (optional)  After an rtc.offer the video plays from the WebRTC track, and
  input moves to the DataChannels the offer opens: "input-fast" (unordered, for
  m move and w) and "input" (reliable). They carry the same JSON as plain
  strings, no type byte. If ICE fails, the client falls back to the frame stream.

  CLOSE CODES (events.close)  4401 rejected, stop · 4409 open elsewhere, stop ·
  4429 rate limited, wait 60 s · 4503 full, retry · anything else: retry with backoff.
-->
<style>
  /* >>> generated:chromium-ui.css >>> */
/* GENERATED by scripts/chromium-ui-import.py -- do not edit.
   Resolved from Chromium source at ref main, themed palette. */
:root{
  --frame:#c2e7ff;           /* kColorSysHeader -- tab strip / window frame */
  --toolbar:#faf9f8;         /* kColorToolbar -- toolbar surface */
  --ntp:#faf9f8;             /* kColorNewTabPageBackground -- new tab page background */
  --tab-active:#faf9f8;      /* kColorTabBackgroundActiveFrameActive -- active tab fill */
  --surface:#fdfcfb;         /* kColorSysSurface -- page surface */
  --field:#e1e9f6;           /* kColorSysBaseContainer -- omnibox at rest */
  --field-focus:#faf9f8;     /* kColorSysBaseContainerElevated -- omnibox focused */
  --text:#1f1f1f;            /* kColorSysOnSurface -- primary text */
  --tabtext:#0b57d0;         /* kColorSysOnHeaderPrimary -- inactive tab text */
  --sep:#a8c7fa;             /* kColorSysOnHeaderDivider -- tab divider */
  --hover:#a8c7fa;           /* kColorSysStateHeaderHover -- tab strip hover */
  --divider:#d3e3fd;         /* kColorSysDivider -- general divider */
  --muted:#004a77;           /* kColorSysOnSurfaceSecondary -- secondary text */
  --ring:#0b57d0;            /* kColorSysStateFocusRing -- focus ring */
  --ph:rgba(31,31,31,0.376);              /* kColorSysStateDisabled -- disabled / unsupported control */
  --hover2:rgba(31,31,31,0.059);          /* kColorSysStateHoverOnSubtle -- stronger hover */
  --icon:var(--muted);            /* kColorToolbarButtonIcon is an HSLShift of the toolbar */
  --shadow:rgba(0,0,0,.16);          /* ui::kColorShadowBase with alpha */
  --scroll:rgba(0,0,0,.28);          /* overlay scrollbar */
  --toolbar-h:40px;       /* no single constant; kToolbarButtonHeight 34 + 2*3 padding */
  --tabstrip-h:41px;      /* kTabStripHeight */
  --tab-h:35px;           /* kTabHeight */
  --tab-pad:6px;         /* kTabStripPadding */
  --tab-pre:8px;         /* kTabPreTitlePadding */
  --tab-post:4px;        /* kTabAfterTitlePadding */
  --tab-close:14px;       /* kTabCloseButtonSize */
  --tb-btn:34px;          /* kToolbarButtonHeight */
  --tb-pad:4px;          /* kToolbarElementPadding */
  --lb-h:34px;            /* kLocationBarHeight */
  --lb-icon:16px;         /* kLocationBarIconSize */
  --lb-margin:9px;       /* kLocationBarMargin */
  --tab-ext:12px;         /* TabStyle::GetBottomCornerRadius */
  --tab-r:10px;           /* TabStyle::GetTopCornerRadius */
  --sep-w:2px;           /* kSeparatorThickness */
  --sep-h:16px;           /* kSeparatorHeight */
  --tb-icon:20px;         /* kToolbarButtonIconSize */
  --tab-overlap:18px;  /* GetTabOverlap = 2*12 - (2*2 + 2) */
  --tab-max:256px;      /* kTabWidth + 2 * GetBottomCornerRadius */
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --frame:#002238;
  --toolbar:#003f66;
  --ntp:#003f66;
  --tab-active:#003f66;
  --surface:#1f1f1f;
  --field:#002845;
  --field-focus:#003f66;
  --text:#e3e3e3;
  --tabtext:#a8c7fa;
  --sep:#003f66;
  --hover:#0842a0;
  --divider:#005789;
  --muted:#7fcfff;
  --ring:#a8c7fa;
  --ph:rgba(227,227,227,0.376);
  --hover2:rgba(253,252,251,0.102);
  --shadow:rgba(0,0,0,.5);
  --scroll:rgba(255,255,255,.3);
}}
:root[data-theme="dark"]{
  --frame:#002238;
  --toolbar:#003f66;
  --ntp:#003f66;
  --tab-active:#003f66;
  --surface:#1f1f1f;
  --field:#002845;
  --field-focus:#003f66;
  --text:#e3e3e3;
  --tabtext:#a8c7fa;
  --sep:#003f66;
  --hover:#0842a0;
  --divider:#005789;
  --muted:#7fcfff;
  --ring:#a8c7fa;
  --ph:rgba(227,227,227,0.376);
  --hover2:rgba(253,252,251,0.102);
  --shadow:rgba(0,0,0,.5);
  --scroll:rgba(255,255,255,.3);
}
  /* <<< generated:chromium-ui.css <<< */
  /* [hidden] is a UA rule; any author `display` beats it. Without this, an
     element styled display:flex stays on screen while .hidden is true. */
  [hidden]{display:none!important}
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;overflow:hidden;background:var(--frame);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Ubuntu,Helvetica,Arial,sans-serif;
    color:var(--text);-webkit-font-smoothing:antialiased}
  #app{display:flex;flex-direction:column;height:100%;user-select:none}
  svg{display:block}
  /* Chromium's vector icons are filled paths, not strokes. */
  .ic{width:16px;height:16px;fill:currentColor;stroke:none}

  /* ---- tab strip ----
     Shape comes from HorizontalTabStyleViews::GetPath(). The active tab is the
     flared shape the source draws as:
         /-----------\
         | Content   |
       __/            \__
     Inactive/hover tabs are a "detached squarcle": a plain rounded rect inset
     by the extension radius, kTabHeight - kTabStripPadding - overlap tall.
     Both are emitted as SVG in tabShape() so the curves are exact at any width. */
  #tabstrip{display:flex;align-items:flex-end;background:var(--frame);
    height:var(--tabstrip-h);min-height:var(--tabstrip-h);padding:0;gap:0}
  #tabs{display:flex;align-items:flex-end;height:100%;flex:0 1 auto;min-width:0}
  .tab{position:relative;display:flex;align-items:center;height:var(--tabstrip-h);
    min-width:52px;width:var(--tab-max);flex:0 1 var(--tab-max);cursor:default;
    color:var(--tabtext);font-size:12px;
    /* content sits inside the extension, then kTabPreTitlePadding */
    padding:0 calc(var(--tab-ext) + var(--tab-post)) 0 calc(var(--tab-ext) + var(--tab-pre));
    margin-right:calc(-1 * var(--tab-overlap)); /* GetTabOverlap() */
  }
  .tab:last-of-type{margin-right:0}
  .tab > svg.shape{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}
  .tab.active > svg.shape path{fill:var(--tab-active)}
  .tab:not(.active) > svg.shape path{fill:transparent}
  .tab:not(.active):hover > svg.shape path{fill:var(--hover)}
  .tab > *:not(svg.shape){position:relative;z-index:1}
  .tab.active{color:var(--text);z-index:2}
  .tab .fav.real{background:none;opacity:1;object-fit:contain}
  .tab .fav{width:16px;height:16px;flex:0 0 16px;border-radius:4px;background:var(--muted);opacity:.35;
    margin-right:var(--tab-pre)}
  .tab.active .fav{opacity:.55}
  .tab .ttl{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .tab .cls{width:var(--tab-close);height:var(--tab-close);flex:0 0 var(--tab-close);
    border-radius:50%;display:flex;align-items:center;justify-content:center;
    color:var(--icon);opacity:0;margin-left:var(--tab-post)}
  .tab:hover .cls,.tab.active .cls{opacity:.85}
  .tab .cls:hover{background:var(--hover2);opacity:1}
  .tab .cls .ic{width:10px;height:10px}
  .tab .spin{width:14px;height:14px;flex:0 0 14px;border:2px solid var(--muted);
    border-top-color:transparent;border-radius:50%;animation:spin .8s linear infinite;
    margin-right:var(--tab-pre)}
  /* kSeparatorThickness x kSeparatorHeight, kSeparatorCornerRadius = w/2 */
  .tab.sepL::before{content:"";position:absolute;left:calc(var(--tab-ext) - 1px);
    top:calc((var(--tabstrip-h) - var(--sep-h)) / 2);
    width:var(--sep-w);height:var(--sep-h);border-radius:calc(var(--sep-w) / 2);
    background:var(--sep);z-index:1}
  @keyframes spin{to{transform:rotate(360deg)}}
  .titem{width:28px;height:28px;flex:0 0 28px;border-radius:50%;display:flex;align-items:center;
    justify-content:center;color:var(--icon);margin:0 2px 4px 2px}
  .titem:hover{background:var(--hover2)}
  .titem.ph{color:var(--ph)}.titem.ph:hover{background:transparent;cursor:default}
  #tabsearch .ic{transform:rotate(90deg)}   /* chevron_right, pointing down */
  #tsp{flex:1 1 auto}

  /* ---- toolbar ---- */
  #toolbar{display:flex;align-items:center;gap:var(--tb-pad);background:var(--toolbar);
    height:var(--toolbar-h);min-height:var(--toolbar-h);padding:0 var(--tb-pad)}
  .tb{width:var(--tb-btn);height:var(--tb-btn);flex:0 0 var(--tb-btn);border-radius:50%;
    display:flex;align-items:center;justify-content:center;color:var(--icon);margin:0 2px}
  .tb:hover{background:var(--hover)}
  .tb.ph{color:var(--ph)}.tb.ph:hover{background:transparent;cursor:default}
  .tb.disabled{color:var(--ph);pointer-events:none}
  .tb .ic{width:var(--tb-icon);height:var(--tb-icon)}
  #omni{flex:1;display:flex;align-items:center;gap:8px;background:var(--field);
    border-radius:calc(var(--lb-h) / 2);height:var(--lb-h);
    padding:0 8px 0 12px;margin:0 var(--lb-margin)}
  #omni.focus{background:var(--field-focus);box-shadow:0 0 0 2px var(--ring)}
  #lead{display:flex;align-items:center;color:var(--muted);flex:0 0 var(--lb-icon)}
  #lead .ic{width:var(--lb-icon);height:var(--lb-icon)}
  #url{flex:1;border:0;outline:0;background:transparent;color:var(--text);font-size:13.5px;
    min-width:0;letter-spacing:.1px}
  #url::placeholder{color:var(--muted)}
  #star{width:26px;height:26px;flex:0 0 26px;border-radius:50%;display:flex;align-items:center;
    justify-content:center;color:var(--ph)}
  #star .ic{width:var(--lb-icon);height:var(--lb-icon)}
  #avatar{color:var(--ph)}
  #avatar .ic{width:22px;height:22px}

  /* ---- viewport ---- */
  #stage{flex:1;position:relative;background:var(--surface);overflow:hidden}
  /* The canvas is the input surface and the fallback picture. When WebRTC is
     live the video sits underneath and the canvas goes transparent, so every
     mouse handler keeps working unchanged. */
  #screen{position:absolute;top:0;left:0;touch-action:none;z-index:1}
  #rtcvideo{position:absolute;top:0;left:0;z-index:0;background:#000;object-fit:fill;pointer-events:none}
  /* New Tab surface. Chrome renders its NTP as WebUI, i.e. browser UI rather than
     web content, so we draw it locally too: no frames, no round trip, and the
     tab is usable the instant it opens. */
  #blank{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
    justify-content:flex-start;padding-top:22vh;gap:28px;background:var(--ntp);z-index:3}
  #blank .ntp-mark{user-select:none;display:flex;align-items:center;justify-content:center}
  #blank .ntp-mark svg{width:272px;height:92px;max-width:60vw;height:auto}
  #blank .ntp-search{width:min(560px,72%);height:48px;border-radius:24px;background:var(--field);
    display:flex;align-items:center;gap:12px;padding:0 18px;
    box-shadow:0 1px 6px rgba(0,0,0,.18)}
  #blank .ntp-search:focus-within{background:var(--field-focus);box-shadow:0 1px 6px rgba(0,0,0,.28)}
  #blank .ntp-search .ic{width:20px;height:20px;color:var(--muted);flex:0 0 20px}
  #blank .ntp-search input{flex:1;border:0;outline:0;background:transparent;color:var(--text);
    font:inherit;font-size:15px;min-width:0}
  #blank .ntp-search input::placeholder{color:var(--muted)}
  #blank .ntp-tiles{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;max-width:560px}
  #blank .tile{display:flex;flex-direction:column;align-items:center;gap:8px;width:76px;
    color:var(--muted);font-size:12px}
  #blank .tile .disc{width:48px;height:48px;border-radius:50%;background:var(--field);
    display:flex;align-items:center;justify-content:center;color:var(--muted)}
  /* latency HUD, opt-in from the menu */
  #lat{position:absolute;right:10px;bottom:10px;z-index:5;pointer-events:none;
    background:rgba(0,0,0,.62);color:#fff;font-size:11px;line-height:1;
    padding:6px 9px;border-radius:6px;font-variant-numeric:tabular-nums;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace}

  /* ---- overlay ---- */
  #overlay{position:absolute;inset:0;background:var(--frame);display:flex;align-items:center;justify-content:center;z-index:20}
  #overlay.hidden{display:none}
  #overlay .card{background:var(--toolbar);padding:26px 30px;border-radius:16px;box-shadow:0 8px 30px var(--shadow);width:min(560px,calc(100vw - 32px));max-width:560px;text-align:center}
  #overlay h1{font-size:16px;margin:14px 0 6px;font-weight:600}
  #overlay p{font-size:13px;color:var(--muted);margin:0}
  #ov-extra{margin-top:16px;text-align:left;max-height:min(52vh,430px);overflow:auto}
  .session-row{border:1px solid var(--divider);border-radius:12px;padding:12px;margin-top:10px;background:var(--surface)}
  .session-top{display:flex;align-items:center;gap:10px}
  .session-name{font-size:13px;font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
  .session-route{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);background:var(--field);border-radius:999px;padding:4px 7px}
  .session-detail{font-size:11px;color:var(--muted);line-height:1.45;margin-top:6px;overflow-wrap:anywhere}
  .session-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px}
  .session-actions button,#manager-refresh{border:0;border-radius:8px;padding:8px 12px;font:inherit;font-size:12px;cursor:pointer}
  .session-actions button{background:#d93025;color:#fff}
  .session-actions button:disabled{opacity:.55;cursor:default}
  #manager-refresh{display:block;margin:12px auto 0;background:var(--field);color:var(--text)}
  .spinner{width:30px;height:30px;border:3px solid var(--muted);border-top-color:transparent;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto}

  /* ---- menu (three-dot) ---- */
  #menu-pop{position:absolute;top:44px;right:8px;z-index:30;background:var(--toolbar);border-radius:12px;box-shadow:0 6px 26px var(--shadow);padding:8px;min-width:260px}
  #menu-pop.hidden{display:none}
  #menu-pop .mi{display:flex;align-items:center;gap:12px;padding:9px 12px;border-radius:8px;font-size:13px;color:var(--text);cursor:default}
  #menu-pop .mi:hover{background:var(--hover)}
  #menu-pop .mi.ph{color:var(--muted)}#menu-pop .mi.ph:hover{background:transparent}
  #menu-pop .mi .ic{width:16px;height:16px;color:var(--icon)}
  #menu-pop hr{border:0;border-top:1px solid var(--sep);margin:6px 4px}
  #menu-pop .sec{font-size:11px;color:var(--muted);padding:6px 12px 2px;text-transform:uppercase;letter-spacing:.4px}
  .set{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:7px 12px;font-size:13px}
  .set input[type=range]{flex:1}
  .set select{padding:4px 8px;border-radius:6px;border:1px solid var(--sep);background:var(--field);color:var(--text);font-size:12px}
  .set .val{min-width:24px;text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}
  #stat{padding:6px 12px;font-size:11px;color:var(--muted)}

  /* ---- dialog ---- */
  #modal{position:absolute;inset:0;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;z-index:40}
  #modal.hidden{display:none}
  #modal .box{background:var(--toolbar);border-radius:12px;padding:20px 22px;min-width:300px;max-width:420px;box-shadow:0 10px 34px var(--shadow)}
  #modal .box h2{font-size:14px;margin:0 0 10px}
  #modal .box .msg{font-size:13px;color:var(--text);white-space:pre-wrap;max-height:200px;overflow:auto;margin-bottom:12px}
  #modal input[type=text]{width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--sep);background:var(--field);color:var(--text);margin-bottom:12px}
  #modal .row{display:flex;gap:10px;justify-content:flex-end}
  #modal button{padding:8px 16px;border:0;border-radius:8px;font-size:13px;cursor:pointer}
  #modal .ok{background:var(--ring);color:#fff}#modal .cancel{background:var(--hover);color:var(--text)}
  .toast{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);background:#2d2e30;color:#fff;padding:9px 16px;border-radius:8px;font-size:13px;z-index:35;box-shadow:0 4px 14px var(--shadow)}
  .toast.hidden{display:none}
</style>
</head>
<body>
<div id="app">
  <div id="tabstrip">
    <div id="tabs"></div>
    <div class="titem" id="newtab" title="New tab"></div>
    <div id="tsp"></div>
    <div class="titem ph" id="tabsearch" title="Search tabs (unavailable)"></div>
  </div>

  <div id="toolbar">
    <div class="tb" id="back" title="Back"></div>
    <div class="tb" id="fwd" title="Forward"></div>
    <div class="tb" id="reload" title="Reload"></div>
    <div id="omni">
      <span id="lead"></span>
      <input id="url" type="text" placeholder="Search or type a URL" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="go">
      <span id="star" class="ph" title="Bookmark (unavailable)"></span>
    </div>
    <div class="tb ph" id="ext" title="Extensions (unavailable)"></div>
    <div class="tb ph" id="avatar" title="Profile (unavailable)"></div>
    <div class="tb" id="menu" title="Menu"></div>
  </div>

  <div id="stage">
    <canvas id="screen" tabindex="0"></canvas>
    <video id="rtcvideo" autoplay playsinline muted hidden></video>
    <div id="lat" hidden></div>
    <div id="blank" hidden>
      <div class="ntp-mark" id="ntpmark"></div>
      <div class="ntp-search"><span id="ntpicon"></span><input id="ntpq" placeholder="Search or type a URL" spellcheck="false" autocomplete="off"></div>
    </div>
    <div id="menu-pop" class="hidden"></div>
    <div id="overlay">
      <div class="card">
        <div class="spinner" id="ov-spin"></div>
        <h1 id="ov-title">Connecting…</h1>
        <p id="ov-msg">Establishing a session.</p>
        <div id="ov-extra"></div>
      </div>
    </div>
    <div id="modal" class="hidden"></div>
    <div id="toast" class="toast hidden"></div>
  </div>
</div>
<script>
// ============================ WIRE IT UP HERE ============================
// connect(events) is called on load and again on every reconnect. Return
// {send, close} synchronously, then report what your transport does:
//   events.open()               it can carry messages now; the client sends "auth"
//   events.message(data)        one whole server message: Uint8Array, ArrayBuffer or string
//   events.close(code, reason)  it is gone; the client retries unless the code says stop
// send(bytes) gets one whole client message as a Uint8Array.
// auth() (optional, may be async) returns extra fields for the "auth" message,
// such as a token. Keep secrets out of copies of this file you give to others.
// server.js's stream port. Keep connect-src in the CSP at the top in step if
// you change it. When server.js serves this page (port 8081) it rewrites both
// for the address the page was loaded from.
const PIXEL_SERVER = "ws://100.117.142.127:8765";
// Must match .pixel-token next to server.js. server.js blanks this line when it
// serves the page, so it only ever lives in the copy on your disk.
const PIXEL_TOKEN = "aurRPcu29igSfv7NFL9anQdr";
window.PixelClientConfig = {
  connect: (events) => {
    const ws = new WebSocket(PIXEL_SERVER);
    ws.binaryType = "arraybuffer";
    ws.onopen = () => events.open();
    ws.onmessage = (e) => events.message(e.data);
    ws.onclose = (e) => events.close(e.code, e.reason);
    return { send: (bytes) => { if (ws.readyState === 1) ws.send(bytes); }, close: () => ws.close() };
  },
  // A served copy gets the token from the URL fragment (#token=...), which
  // browsers never send in requests; server.js prints that link when it starts.
  auth: () => ({ token: PIXEL_TOKEN || new URLSearchParams(location.hash.slice(1)).get("token") || "" }),
};
